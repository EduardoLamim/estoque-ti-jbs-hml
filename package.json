{
  "name": "estoque-ti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.edge.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write src tests scripts supabase/functions types *.ts *.json .github/workflows eslint.config.js index.html",
    "test:hml": "node --env-file=.env.local --env-file=.env.hml-test.local scripts/smoke-hml.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "qrcode": "^1.5.4",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@eslint/js": "^9.36.0",
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
